# VITE_API_URL=http://192.168.1.47:5000

# Optional. Shows a coloured environment badge in the ADMIN topbar so an
# operator can tell a local panel from a production one at a glance - the
# actions in there delete real accounts and move real money.
#
# Leave it UNSET to show no badge at all. Recognised values get a distinct
# colour: production/prod/live = red, staging/stage/qa = amber,
# local/development/dev = neutral grey. Anything else renders neutral.
# VITE_ENV_LABEL=local
