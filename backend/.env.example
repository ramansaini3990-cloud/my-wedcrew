PORT=
MONGODB_URI=
JWT_SECRET=

# --- Admin seeder (npm run seed:admin) ---
# Required
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional (defaults shown in comments)
ADMIN_FIRST_NAME=       # "Site"
ADMIN_LAST_NAME=        # "Administrator"
ADMIN_MOBILE=           # "0000000000"

# IMPORTANT: if a value contains '#', wrap it in SINGLE QUOTES.
# dotenv treats an unquoted '#' as the start of a comment, so
#   ADMIN_PASSWORD=secret#123   loads as "secret"   <-- wrong
#   ADMIN_PASSWORD='secret#123' loads as "secret#123"
# The seeder refuses to run if it detects this, rather than hashing a
# password you cannot log in with.

# --- Payments ------------------------------------------------------------
# Which provider adapter to use: "sandbox" (default) or "razorpay".
# Leave blank to auto-select: razorpay when its keys are present, else sandbox.
# Sandbox needs no keys and settles no real money - it exists so the whole
# payment flow, including webhooks, is testable end to end.
PAYMENT_PROVIDER=

# Razorpay. KEY_ID is publishable and is sent to the browser for Checkout.
# KEY_SECRET and WEBHOOK_SECRET are server-only and must NEVER be exposed.
# Use rzp_test_* keys during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Signing secret for the sandbox adapter. Any non-empty string; only used
# when PAYMENT_PROVIDER resolves to "sandbox".
SANDBOX_PAYMENT_SECRET=

# Reminder: if a value contains '#', wrap it in SINGLE QUOTES (see above).

# --- CORS / environment --------------------------------------------------
# Environment. Only "production" disables the localhost/LAN auto-allow.
NODE_ENV=

# CORS — comma-separated origins, scheme included, NO trailing slash.
# Example: https://mywedcrew.com,https://www.mywedcrew.com
# Empty in production means every cross-origin browser request is rejected.
CORS_ORIGINS=

# Allow private LAN origins (10.x, 192.168.x, 172.16-31.x) for phone testing on
# the same wifi. Ignored when NODE_ENV=production.
CORS_ALLOW_LAN=false

# --- Auth ----------------------------------------------------------------
# JWT lifetime (zeit/ms format: "7d", "12h", "30m"). Default: 7d.
JWT_EXPIRES_IN=7d

# --- Rate limiting -------------------------------------------------------
# Window applied to all limiters, in milliseconds. Default: 900000 (15 min).
RATE_LIMIT_WINDOW_MS=900000
# Requests per window per IP.
# auth    = POST /api/auth/login and /register            (default 10)
# payment = payment create/verify/refund + withdrawals     (default 20)
# api     = broad backstop across all /api routes          (default 300)
# NOTE: POST /api/payments/webhook is never rate limited.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_API_MAX=300

# --- Email / verification ------------------------------------------------
# Adapter: "console" (default) logs the verification link to the server console
# and sends nothing - the mail equivalent of PAYMENT_PROVIDER=sandbox, so local
# dev and the E2E suites need no mailbox. "brevo" sends for real.
# Leave blank to auto-select: brevo when BREVO_API_KEY is set, else console.
EMAIL_PROVIDER=

# Brevo transactional API key. SERVER ONLY - never exposed, never logged.
BREVO_API_KEY=

# Sender identity. The address must be a verified sender in Brevo.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Public origin of the FRONTEND. Verification links are built as
# <APP_PUBLIC_URL>/verify-email?token=... so this must be the site users open,
# not the API host. No trailing slash.
APP_PUBLIC_URL=

# Require a confirmed email address before login. Default true.
# FORCED to true when NODE_ENV=production, whatever this says.
EMAIL_VERIFICATION_REQUIRED=true

# MX-record lookup during signup. Default true. Fails OPEN on resolver error or
# timeout, so a broken DNS resolver can never block all signups.
EMAIL_MX_CHECK_ENABLED=true
