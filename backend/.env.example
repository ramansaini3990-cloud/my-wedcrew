PORT=
MONGODB_URI=
JWT_SECRET=

# --- Admin seeder (npm run seed:admin) ---
# Required
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional (defaults shown in comments)
ADMIN_FIRST_NAME=       # "Site"
ADMIN_LAST_NAME=        # "Administrator"
ADMIN_MOBILE=           # "0000000000"

# IMPORTANT: if a value contains '#', wrap it in SINGLE QUOTES.
# dotenv treats an unquoted '#' as the start of a comment, so
#   ADMIN_PASSWORD=secret#123   loads as "secret"   <-- wrong
#   ADMIN_PASSWORD='secret#123' loads as "secret#123"
# The seeder refuses to run if it detects this, rather than hashing a
# password you cannot log in with.

# --- Payments ------------------------------------------------------------
# Which provider adapter to use: "sandbox" (default) or "razorpay".
# Leave blank to auto-select: razorpay when its keys are present, else sandbox.
# Sandbox needs no keys and settles no real money - it exists so the whole
# payment flow, including webhooks, is testable end to end.
PAYMENT_PROVIDER=

# Razorpay. KEY_ID is publishable and is sent to the browser for Checkout.
# KEY_SECRET and WEBHOOK_SECRET are server-only and must NEVER be exposed.
# Use rzp_test_* keys during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Signing secret for the sandbox adapter. Any non-empty string; only used
# when PAYMENT_PROVIDER resolves to "sandbox".
SANDBOX_PAYMENT_SECRET=

# Reminder: if a value contains '#', wrap it in SINGLE QUOTES (see above).

# --- CORS / environment --------------------------------------------------
# Environment. Only "production" disables the localhost/LAN auto-allow.
NODE_ENV=

# CORS — comma-separated origins, scheme included, NO trailing slash.
# Example: https://mywedcrew.com,https://www.mywedcrew.com
# Empty in production means every cross-origin browser request is rejected.
CORS_ORIGINS=

# Allow private LAN origins (10.x, 192.168.x, 172.16-31.x) for phone testing on
# the same wifi. Ignored when NODE_ENV=production.
CORS_ALLOW_LAN=false
